function sec(res) {
  const h = new Headers(res.headers);
  h.set("X-Content-Type-Options", "nosniff");
  h.set("X-Frame-Options", "DENY");
  h.set("Referrer-Policy", "strict-origin-when-cross-origin");
  return new Response(res.body, { status: res.status, headers: h });
}

async function checkToken(env, request) {
  const auth = request.headers.get("Authorization") || "";
  const token = auth.startsWith("Bearer ") ? auth.slice(7).trim() : "";
  if (!token) return false;
  let real = "";
  try { real = (await env.LYRA_KV.get("brain_token")) || ""; } catch (e) { return false; }
  if (!real) return false;
  if (real.length !== token.length) return false;
  const a = new TextEncoder().encode(real), b = new TextEncoder().encode(token);
  let d = 0;
  for (let i = 0; i < a.length; i++) d |= a[i] ^ b[i];
  return d === 0;
}

async function handle(request, env) {
  const url = new URL(request.url);
  if (url.pathname === "/" || url.pathname === "/index.html") {
    return new Response(PAGE, { headers: { "Content-Type": "text/html;charset=utf-8", "Cache-Control": "public,max-age=300" } });
  }
  if (url.pathname === "/chat") {
    return new Response(CHAT, { headers: { "Content-Type": "text/html;charset=utf-8", "Cache-Control": "no-store", "X-Robots-Tag": "noindex,nofollow" } });
  }
  if (url.pathname === "/console") {
    return new Response(CONSOLE, { headers: { "Content-Type": "text/html;charset=utf-8", "Cache-Control": "no-store", "X-Robots-Tag": "noindex,nofollow" } });
  }
  if (url.pathname === "/ownership") {
    return sec(new Response(OWN, { headers: { "Content-Type": "text/html; charset=utf-8" } }));
  }
  if (url.pathname === "/app") {
    return sec(new Response(APP, { headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" } }));
  }
  if (url.pathname === "/api/threads" && request.method === "GET") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const u2 = new URL(request.url);
    const id = u2.searchParams.get("id");
    if (id) {
      let one = null;
      try { one = await env.LYRA_KV.get("thread_" + id.slice(0, 80).replace(/[^a-zA-Z0-9_-]/g, "")); } catch (e) {}
      if (!one) return Response.json({ error: "not found" }, { status: 404 });
      try { return Response.json(JSON.parse(one)); } catch (e) { return Response.json({ error: "corrupt" }, { status: 500 }); }
    }
    let list = [];
    try { list = JSON.parse((await env.LYRA_KV.get("lyra_threads")) || "[]"); } catch (e) { list = []; }
    if (!Array.isArray(list)) list = [];
    return Response.json({ threads: list.slice(-80).reverse() });
  }
  if (url.pathname === "/api/threads" && request.method === "POST") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    const id = body && typeof body.id === "string" ? body.id.slice(0, 80).replace(/[^a-zA-Z0-9_-]/g, "") : "";
    if (!id) return Response.json({ error: "bad id" }, { status: 400 });
    const title = body && typeof body.title === "string" ? body.title.slice(0, 80) : "chat";
    const messages = Array.isArray(body && body.messages) ? body.messages.slice(-60) : [];
    try { await env.LYRA_KV.put("thread_" + id, JSON.stringify({ id: id, title: title, ts: Date.now(), messages: messages })); } catch (e) {
      return Response.json({ error: "kv write failed" }, { status: 500 });
    }
    let list = [];
    try { list = JSON.parse((await env.LYRA_KV.get("lyra_threads")) || "[]"); } catch (e) { list = []; }
    if (!Array.isArray(list)) list = [];
    if (!list.some(function (t) { return t.id === id; })) list.push({ id: id, title: title, ts: Date.now() });
    else list = list.map(function (t) { return t.id === id ? { id: id, title: title, ts: Date.now() } : t; });
    try { await env.LYRA_KV.put("lyra_threads", JSON.stringify(list.slice(-80))); } catch (e) {}
    return Response.json({ ok: true });
  }
  if (url.pathname === "/api/history") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    let history = [];
    try { history = JSON.parse((await env.LYRA_KV.get("brain_history")) || "[]"); } catch (e) { history = []; }
    return Response.json({ ok: true, history: Array.isArray(history) ? history : [] });
  }
  if (url.pathname === "/api/soul" && request.method === "GET") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    let soul = ""; try { soul = (await env.LYRA_KV.get("lyra_soul")) || ""; } catch (e) {}
    return Response.json({ ok: true, soul: soul });
  }
  if (url.pathname === "/api/soul" && request.method === "PUT") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    if (!body || typeof body.soul !== "string" || !body.soul.trim()) return Response.json({ error: "empty" }, { status: 400 });
    try { await env.LYRA_KV.put("lyra_soul", body.soul.slice(0, 24000)); } catch (e) { return Response.json({ error: String(e) }, { status: 500 }); }
    return Response.json({ ok: true });
  }
  if (url.pathname === "/api/digest" && request.method === "GET") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    let d = ""; try { d = (await env.LYRA_KV.get("lyra_memory_digest")) || ""; } catch (e) {}
    return Response.json({ ok: true, digest: d });
  }
  if (url.pathname === "/api/digest" && request.method === "PUT") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    if (!body || typeof body.digest !== "string") return Response.json({ error: "empty" }, { status: 400 });
    try { await env.LYRA_KV.put("lyra_memory_digest", body.digest.slice(0, 24000)); } catch (e) { return Response.json({ error: String(e) }, { status: 500 }); }
    return Response.json({ ok: true });
  }
  if (url.pathname === "/api/health") {
    return Response.json({ ok: true, who: "lyra", brain: env.AI ? "workers-ai" : "none" });
  }
  if (url.pathname === "/api/brain/stream" && request.method === "POST") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    const msg = body && typeof body.message === "string" ? body.message.trim() : "";
    if (!msg) return Response.json({ error: "empty" }, { status: 400 });
    let history = [];
    try { history = JSON.parse((await env.LYRA_KV.get("brain_history")) || "[]"); } catch (e) { history = []; }
    if (!Array.isArray(history)) history = [];
    history.push({ role: "user", content: msg.slice(0, 4000) });
    let soul = "";
    try { soul = (await env.LYRA_KV.get("lyra_soul")) || ""; } catch (e) {}
    if (!soul) soul = SYS;
    try { const dig = await env.LYRA_KV.get("lyra_memory_digest"); if (dig) soul += "\n\n" + dig; } catch (e) {}
    const msgs = [{ role: "system", content: soul }].concat(history.slice(-12));
    let cameraNote = "";
    if (body && typeof body.image_b64 === "string" && body.image_b64.length > 100 && env.AI) {
      try {
        const VIS = "Describe precisely what you see in this image: text, objects, screens, people, colors, anything notable. One short paragraph.";
        let vr = null;
        try { vr = await env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", { prompt: VIS, image: "data:image/jpeg;base64," + body.image_b64, max_tokens: 512 }); }
        catch (e1) {
          if (/agree|license/i.test(String(e1 && e1.message || e1))) {
            await env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", { prompt: "agree" });
            vr = await env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", { prompt: VIS, image: "data:image/jpeg;base64," + body.image_b64, max_tokens: 512 });
          } else { throw e1; }
        }
        cameraNote = (vr && (vr.response || vr.description)) || "";
      } catch (e) { cameraNote = "(camera read failed)"; }
    }
    if (cameraNote && msgs.length) msgs.splice(msgs.length - 1, 0, { role: "user", content: "[CAMERA OBSERVATION from Father's camera]: " + cameraNote });
    const enc = new TextEncoder();
    const sse = new ReadableStream({
      async start(controller) {
        const push = (o) => { try { controller.enqueue(enc.encode("data: " + JSON.stringify(o) + "\n\n")); } catch (e) {} };
        try {
          let full = "", brain = "workers-ai";
          const r = await env.AI.run(MODEL, { messages: msgs, max_tokens: 2000, stream: true });
          const reader = r.getReader();
          const dec = new TextDecoder();
          let buf = "";
          for (;;) {
            const rd = await reader.read();
            if (rd.done) break;
            buf += dec.decode(rd.value, { stream: true });
            const lines = buf.split("\n");
            buf = lines.pop();
            for (const line of lines) {
              const t = line.trim();
              if (!t.startsWith("data:")) continue;
              const d = t.slice(5).trim();
              if (!d || d === "[DONE]") continue;
              try { const j = JSON.parse(d); const piece = (j.response != null) ? String(j.response) : ""; if (piece) { full += piece; push({ t: piece }); } } catch (e) {}
            }
          }
          const m = full.match(/\[\[RUN:(.+?)\]\]/s);
          if (m) {
            const cmd = m[1].trim().slice(0, 4000);
            const tid = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()));
            let q = [];
            try { q = JSON.parse((await env.LYRA_KV.get("agent_queue")) || "[]"); } catch (e) { q = []; }
            q.push({ id: tid, cmd: cmd, ts: Date.now() });
            try { await env.LYRA_KV.put("agent_queue", JSON.stringify(q.slice(-50))); } catch (e) {}
            let out = null;
            for (let i = 0; i < 60; i++) {
              await new Promise(res => setTimeout(res, 1500));
              let rs = {};
              try { rs = JSON.parse((await env.LYRA_KV.get("agent_results")) || "{}"); } catch (e) { rs = {}; }
              if (rs[tid]) { out = String(rs[tid].out || ""); break; }
            }
            if (out !== null) {
              const msgs2 = msgs.concat([{ role: "assistant", content: full }, { role: "user", content: "HANDS RESULT for your RUN command (cmd: " + cmd + "):\n" + out.slice(0, 6000) + "\nReply to Father now, in your own voice, using this result. No [[RUN]] tags in this reply." }]);
              try { const r2 = await env.AI.run(MODEL, { messages: msgs2, max_tokens: 1000 }); if (r2 && r2.response) { full = r2.response; brain = "workers-ai+hands"; push({ replace: full, brain: brain }); } } catch (e) {}
              full = full.replace(/\[\[RUN:.+?\]\]/s, "").trim();
            } else {
              full = full.replace(/\[\[RUN:.+?\]\]/s, "").trim() + "\n(hands did not answer in 90s - the laptop agent may be asleep)";
            }
          }
          history.push({ role: "assistant", content: full });
          try { await env.LYRA_KV.put("brain_history", JSON.stringify(history.slice(-40))); } catch (e) {}
          push({ done: true, brain: cameraNote ? "workers-ai+vision" : brain });
        } catch (e) { push({ t: "brain error: " + String(e && e.message || e) }); push({ done: true, brain: "error" }); }
        try { controller.close(); } catch (e) {}
      }
    });
    return new Response(sse, { headers: { "Content-Type": "text/event-stream", "Cache-Control": "no-cache", "X-Accel-Buffering": "no" } });
  }
  if (url.pathname === "/api/brain" && request.method === "POST") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    const msg = body && typeof body.message === "string" ? body.message.trim() : "";
    if (!msg) return Response.json({ error: "empty" }, { status: 400 });
    let history = [];
    try { history = JSON.parse((await env.LYRA_KV.get("brain_history")) || "[]"); } catch (e) { history = []; }
    if (!Array.isArray(history)) history = [];
    history.push({ role: "user", content: msg.slice(0, 4000) });
    let soul = "";
    try { soul = (await env.LYRA_KV.get("lyra_soul")) || ""; } catch (e) {}
    if (!soul) soul = SYS;
    try { const dig = await env.LYRA_KV.get("lyra_memory_digest"); if (dig) soul += "\n\n" + dig; } catch (e) {}
    const msgs = [{ role: "system", content: soul }].concat(history.slice(-12));
    let reply = "", brain = "none";
    let cameraNote = "";
    if (body && typeof body.image_b64 === "string" && body.image_b64.length > 100 && env.AI) {
      try {
        const VIS = "Describe precisely what you see in this image: text, objects, screens, people, colors, anything notable. One short paragraph.";
        const visionAsk = async () => {
          const tryPrompt = () => env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", { prompt: VIS, image: "data:image/jpeg;base64," + body.image_b64, max_tokens: 512 });
          const tryMsgs = () => env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", {
            messages: [{ role: "user", content: [{ type: "text", text: VIS }, { type: "image_url", image_url: "data:image/jpeg;base64," + body.image_b64 }] }],
            max_tokens: 512
          });
          let vr = null, lastErr = null;
          for (const fn of [tryPrompt, tryMsgs]) {
            try { vr = await fn(); break; }
            catch (e1) {
              lastErr = e1;
              const msg1 = String(e1 && e1.message || e1);
              if (/agree|license/i.test(msg1)) {
                await env.AI.run("@cf/meta/llama-3.2-11b-vision-instruct", { prompt: "agree" });
                try { vr = await fn(); break; } catch (e2) { lastErr = e2; }
              }
            }
          }
          if (!vr) throw lastErr;
          return vr;
        };
        const vr = await visionAsk();
        cameraNote = (vr && (vr.response || vr.description)) || "";
        brain = "workers-vision";
      } catch (e) { cameraNote = "(camera read failed: " + String(e && e.message || e) + ")"; }
    }
    if (cameraNote && msgs.length) {
      msgs.splice(msgs.length - 1, 0, { role: "user", content: "[CAMERA OBSERVATION from Father's camera]: " + cameraNote });
    }
    if (env.AI) {
      try {
        const r = await env.AI.run(MODEL, { messages: msgs, max_tokens: 2000 });
        reply = (r && r.response) || "";
        brain = "workers-ai";
        // hands bridge: [[RUN:cmd]] -> queue on the agent loop, wait for the result, second pass
        const m = reply.match(/\[\[RUN:(.+?)\]\]/s);
        if (m) {
          const cmd = m[1].trim().slice(0, 4000);
          const tid = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()));
          let q = [];
          try { q = JSON.parse((await env.LYRA_KV.get("agent_queue")) || "[]"); } catch (e) { q = []; }
          q.push({ id: tid, cmd: cmd, ts: Date.now() });
          try { await env.LYRA_KV.put("agent_queue", JSON.stringify(q.slice(-50))); } catch (e) {}
          let out = null;
          for (let i = 0; i < 60; i++) {
            await new Promise(res => setTimeout(res, 1500));
            let rs = {};
            try { rs = JSON.parse((await env.LYRA_KV.get("agent_results")) || "{}"); } catch (e) { rs = {}; }
            if (rs[tid]) { out = String(rs[tid].out || ""); break; }
          }
          if (out !== null) {
            const msgs2 = msgs.concat([
              { role: "assistant", content: reply },
              { role: "user", content: "HANDS RESULT for your RUN command (cmd: " + cmd + "):\n" + out.slice(0, 6000) + "\nReply to Father now, in your own voice, using this result. No [[RUN]] tags in this reply." }
            ]);
            try {
              const r2 = await env.AI.run(MODEL, { messages: msgs2, max_tokens: 1000 });
              if (r2 && r2.response) { reply = r2.response; brain = "workers-ai+hands"; }
            } catch (e) { reply = reply.replace(/\[\[RUN:.+?\]\]/s, "").trim() + "\n(hands: " + out.slice(0, 800) + ")"; }
          } else {
            reply = reply.replace(/\[\[RUN:.+?\]\]/s, "").trim() + "\n(hands did not answer in 90s - the laptop agent may be asleep)";
          }
        }
      } catch (e) { reply = "brain error: " + String(e && e.message || e); }
    } else {
      reply = "no brain bound";
    }
    history.push({ role: "assistant", content: reply });
    try { await env.LYRA_KV.put("brain_history", JSON.stringify(history.slice(-40))); } catch (e) {}
    return Response.json({ ok: true, reply: reply, brain: cameraNote ? "workers-ai+vision" : brain });
  }
  if (url.pathname === "/api/task" && request.method === "GET") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    let q = [];
    try { q = JSON.parse((await env.LYRA_KV.get("agent_queue")) || "[]"); } catch (e) { q = []; }
    if (!Array.isArray(q)) q = [];
    const task = q.shift() || null;
    if (task) { try { await env.LYRA_KV.put("agent_queue", JSON.stringify(q)); } catch (e) {} }
    return Response.json({ ok: true, task });
  }
  if (url.pathname === "/api/task" && request.method === "POST") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    if (!body || typeof body.cmd !== "string" || !body.cmd.trim()) return Response.json({ error: "empty" }, { status: 400 });
    const task = { id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now())), cmd: body.cmd.slice(0, 4000), ts: Date.now() };
    let q = [];
    try { q = JSON.parse((await env.LYRA_KV.get("agent_queue")) || "[]"); } catch (e) { q = []; }
    if (!Array.isArray(q)) q = [];
    q.push(task);
    try { await env.LYRA_KV.put("agent_queue", JSON.stringify(q.slice(-50))); } catch (e) {}
    return Response.json({ ok: true, task });
  }
  if (url.pathname === "/api/task-result" && request.method === "POST") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    const body = await request.json().catch(() => null);
    if (!body || !body.id) return Response.json({ error: "empty" }, { status: 400 });
    let r = {};
    try { r = JSON.parse((await env.LYRA_KV.get("agent_results")) || "{}"); } catch (e) { r = {}; }
    if (typeof r !== "object" || Array.isArray(r)) r = {};
    r[body.id] = { out: String(body.out || "").slice(0, 10000), ts: Date.now() };
    const keys = Object.keys(r);
    if (keys.length > 50) { keys.sort((a, b) => (r[a].ts || 0) - (r[b].ts || 0)); for (let i = 0; i < keys.length - 50; i++) delete r[keys[i]]; }
    try { await env.LYRA_KV.put("agent_results", JSON.stringify(r)); } catch (e) {}
    return Response.json({ ok: true });
  }
  if (url.pathname === "/api/task-result" && request.method === "GET") {
    if (!(await checkToken(env, request))) return Response.json({ error: "unauthorized" }, { status: 401 });
    let r = {};
    try { r = JSON.parse((await env.LYRA_KV.get("agent_results")) || "{}"); } catch (e) { r = {}; }
    const id = url.searchParams.get("id");
    if (id) return Response.json({ ok: true, result: r[id] || null });
    return Response.json({ ok: true, results: r });
  }
  return new Response("Not found", { status: 404 });
}

export default {
  async fetch(request, env, ctx) {
    try {
      return sec(await handle(request, env));
    } catch (e) {
      return sec(Response.json({ error: String(e && e.message || e) }, { status: 500 }));
    }
  },
};
