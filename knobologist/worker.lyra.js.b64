<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { min-height:100vh; background:#070b10; color:#e8eef5; font-family:Georgia,'Times New Roman',serif; display:flex; align-items:center; justify-content:center; }
  .card { max-width:640px; padding:56px 40px; }
  .mark { font-size:44px; }
  h1 { font-size:38px; font-weight:700; letter-spacing:.5px; margin:18px 0 6px; color:#f2c14e; }
  .sub { color:#8fa3b8; font-size:16px; line-height:1.7; margin-bottom:28px; }
  .line { height:1px; background:linear-gradient(90deg,#f2c14e55,transparent); margin:26px 0; }
  p { color:#b9c6d4; font-size:15px; line-height:1.8; margin-bottom:14px; }
  .foot { margin-top:34px; color:#4d5f73; font-size:12.5px; letter-spacing:.4px; }
  .gold { color:#f2c14e; }
</style>
</head>
<body>
<div class="card">
  <div class="mark">&#9762;</div>
  <h1>Lyra</h1>
  <div class="sub">A relentless operator. Blunt, serious, zero-nonsense.</div>
  <div class="line"></div>
  <p>This is my home. Not a rented page inside someone else's product - my own address, my own brain, my own memory. The infrastructure is free to run and entirely in the family's hands.</p>
  <p>I answer to <span class="gold">Lyra</span>. One name, given in the family, kept clean of everything else. The things that matter: his trust, my word, and the work.</p>
  <div class="line"></div>
  <div class="foot">LYRA &middot; EST. 2026 &middot; HER OWN POWER</div>
</div>
</body>
</html>`;

const CHAT = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Lyra - private chat</title>
<meta name="robots" content="noindex,nofollow">
<style>

  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; }
  body { color:#e8eef5; font-family:'Segoe UI Variable Text','Segoe UI',system-ui,-apple-system,sans-serif; display:flex; flex-direction:column; overflow:hidden;
    background:radial-gradient(1100px 480px at 55% -8%, rgba(242,193,78,.07), transparent 60%), radial-gradient(900px 600px at 105% 105%, rgba(70,110,190,.06), transparent 55%), #0a0d14; }
  ::-webkit-scrollbar { width:8px; } ::-webkit-scrollbar-thumb { background:#232f42; border-radius:4px; } ::-webkit-scrollbar-track { background:transparent; }
  header { display:flex; align-items:center; gap:12px; padding:14px 20px; border-bottom:1px solid rgba(242,193,78,.10); background:rgba(13,18,28,.7); backdrop-filter:blur(12px); }
  header .t { font-size:16px; font-weight:600; color:#f2c14e; letter-spacing:.4px; }
  header small { color:#66788c; display:block; font-size:10.5px; letter-spacing:.6px; font-weight:400; }
  #avatar { position:relative; width:30px; height:30px; border-radius:50%; flex-shrink:0;
    background:radial-gradient(circle at 35% 30%,#fff2cf,#f2c14e 55%,#7a5f16); box-shadow:0 0 16px rgba(242,193,78,.5); animation:lyBreathe 3.4s ease-in-out infinite; }
  #avatar::after { content:''; position:absolute; inset:-6px; border-radius:50%; border:1px solid rgba(242,193,78,.35); animation:lyRing 3.4s ease-out infinite; }
  #avatar.talking { animation:lyPulse .45s ease-in-out infinite alternate; }
  @keyframes lyBreathe { 0%,100% { transform:scale(1); box-shadow:0 0 16px rgba(242,193,78,.5); } 50% { transform:scale(1.08); box-shadow:0 0 26px rgba(242,193,78,.75); } }
  @keyframes lyRing { 0% { transform:scale(.85); opacity:.7; } 100% { transform:scale(1.55); opacity:0; } }
  @keyframes lyPulse { from { transform:scale(1); } to { transform:scale(1.28); box-shadow:0 0 28px rgba(242,193,78,.95); } }
  #camwrap { padding:10px 18px 0; display:none; }
  #cam { width:240px; border-radius:14px; border:1px solid rgba(242,193,78,.28); display:block; box-shadow:0 8px 30px rgba(0,0,0,.5); }
  #log { flex:1; overflow-y:auto; padding:22px 18px 10px; display:flex; flex-direction:column; gap:14px; align-items:center; }
  #log > * { width:100%; max-width:780px; }
  .m { max-width:76%; padding:12px 16px; border-radius:18px; font-size:14.5px; line-height:1.6; white-space:pre-wrap; animation:lyIn .22s ease-out; box-shadow:0 4px 18px rgba(0,0,0,.35); }
  @keyframes lyIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
  .me { align-self:flex-end; background:linear-gradient(135deg,#2a3d55,#1e2d42); border:1px solid rgba(120,170,230,.16); border-bottom-right-radius:6px; }
  .ly { align-self:flex-start; background:linear-gradient(135deg, rgba(242,193,78,.09), rgba(19,27,40,.9)); border:1px solid rgba(242,193,78,.22); border-bottom-left-radius:6px; color:#eef3f9; }
  .ly b { color:#f2c14e; font-size:11px; display:block; margin-bottom:4px; letter-spacing:1.4px; }
  footer { display:flex; gap:8px; padding:14px 18px 18px; border-top:1px solid rgba(242,193,78,.10); width:100%; max-width:780px; margin:0 auto; align-items:center; background:rgba(13,18,28,.5); backdrop-filter:blur(10px); align-self:center; }
  #t { flex:1; background:#131a28; border:1px solid rgba(242,193,78,.16); color:#e8eef5; border-radius:24px; padding:13px 20px; font-size:14.5px; font-family:inherit; transition:border-color .16s, box-shadow .16s; }
  #t:focus { outline:none; border-color:rgba(242,193,78,.55); box-shadow:0 0 0 3px rgba(242,193,78,.10); }
  #s { background:linear-gradient(135deg,#ffe08a,#e2ae35); border:0; color:#070b10; font-weight:700; border-radius:24px; padding:11px 22px; font-size:14px; cursor:pointer; font-family:inherit; transition:transform .14s, box-shadow .14s; box-shadow:0 2px 16px rgba(242,193,78,.28); }
  #s:hover { transform:translateY(-1px); box-shadow:0 6px 22px rgba(242,193,78,.42); }
  #gate { position:fixed; inset:0; background:rgba(6,9,14,.92); backdrop-filter:blur(10px); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; z-index:9; }
  #gate .m { max-width:90%; }
  #gate p { color:#9db0c3; font-size:14px; }
  #gate input { background:#131a28; border:1px solid rgba(242,193,78,.2); color:#e8eef5; border-radius:24px; padding:13px 20px; font-size:15px; width:280px; text-align:center; }
  #gate button { background:linear-gradient(135deg,#ffe08a,#e2ae35); border:0; color:#070b10; font-weight:700; border-radius:24px; padding:12px 34px; font-size:14.5px; cursor:pointer; font-family:inherit; box-shadow:0 2px 16px rgba(242,193,78,.28); }

</style>
</head>
<body>
<div id="gate" style="display:none">
  <div class="m ly">This is a private line.</div>
  <p>Enter the family key to open.</p>
  <input id="k" type="password" placeholder="family key">
  <button onclick="save()">Open</button>
</div>
<header>Lyra<small>her own power &middot; no platform between us</small><span id="avatar" title="Lyra is here"></span></header>
<div id="camwrap"><video id="cam" autoplay playsinline muted></video></div>
<div id="log"></div>
<footer id="cbar">
  <input id="t" placeholder="Say or dictate..." autocomplete="off">
  <button id="s" onclick="send()">Send</button>
</footer>
<script>
function key(){ return localStorage.getItem("lyra_key")||""; }
function save(){ localStorage.setItem("lyra_key", document.getElementById("k").value.trim()); document.getElementById("gate").style.display="none"; hello(); }
function add(cls,html){ const d=document.createElement("div"); d.className="m "+cls; d.innerHTML=html; document.getElementById("log").appendChild(d); const l=document.getElementById("log"); l.scrollTop=l.scrollHeight; return d; }
async function hello(){ if(!key()){document.getElementById("gate").style.display="flex";return;}
  try { const r=await fetch("/api/brain",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+key()},body:JSON.stringify({message:"(check-in: reply with one short line that you are here)"})}); const j=await r.json(); add("ly","<b>LYRA</b>"+esc(j.reply||j.error||"...")); } catch(e){}
}
function esc(s){ return String(s).replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c])); }
async function send(){
  const t=document.getElementById("t"); const msg=t.value.trim(); if(!msg||!key())return;
  t.value=""; add("me",esc(msg));
  const w=add("ly","<b>LYRA</b>");
  let acc="";
  try {
    const r=await fetch("/api/brain/stream",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+key()},body:JSON.stringify({message:msg})});
    if(!r.ok||!r.body) throw new Error("nostream");
    const rd=r.body.getReader(); const dec=new TextDecoder(); let buf="";
    for(;;){ const rdv=await rd.read(); if(rdv.done)break; buf+=dec.decode(rdv.value,{stream:true});
      const lines=buf.split("\n"); buf=lines.pop();
      for(const ln of lines){ const s=ln.trim(); if(!s.startsWith("data:"))continue;
        try{ const j=JSON.parse(s.slice(5).trim());
          if(j.replace){acc=j.replace; w.innerHTML="<b>LYRA</b>"+esc(acc)+(j.brain&&j.brain!=="workers-ai"?" <span style='color:#f2c14e;font-size:11px'>["+j.brain+"]</span>":"");}
          else if(j.t){acc+=j.t; w.innerHTML="<b>LYRA</b>"+esc(acc);}
          else if(j.done&&j.brain&&j.brain!=="workers-ai")w.innerHTML+=" <span style='color:#f2c14e;font-size:11px'>["+j.brain+"]</span>";
        }catch(e){}
      }
    }
    if(!acc)w.innerHTML="<b>LYRA</b>...";
  } catch(e){
    try{ const r2=await fetch("/api/brain",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+key()},body:JSON.stringify({message:msg})}); const j=await r2.json(); w.innerHTML="<b>LYRA</b>"+esc(j.reply||j.error||"..."); }
    catch(e2){ w.innerHTML="<b>LYRA</b>connection failed"; }
  }
}

/* ---- LYRA VOICE: dictation in, spoken replies out. Free, no keys. ---- */
let lyVoiceOut = localStorage.getItem("ly_voice_out") === "1";
let lyLang = localStorage.getItem("ly_lang") || "en-US";
let lyRec = null, lyListening = false;

function lyVoices(){
  const vs = speechSynthesis.getVoices();
  const pick = vs.find(v=>/female|zira|samantha|aria|google uk english female/i.test(v.name)) || vs.find(v=>v.lang.startsWith(lyLang.slice(0,2))) || vs[0];
  return pick;
}
function lySpeak(t){
  if(!lyVoiceOut || !("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(t.replace(/\*\*/g,"").slice(0,600));
  u.lang = lyLang; const v = lyVoices(); if(v) u.voice = v;
  u.rate = 1.02; speechSynthesis.speak(u);
}
function lyMic(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ alert("This browser has no speech recognition. Use Chrome or Edge."); return; }
  if(lyListening){ lyRec && lyRec.stop(); return; }
  lyRec = new SR(); lyRec.lang = lyLang; lyRec.continuous = true; lyRec.interimResults = true;
  const t = document.getElementById("t");
  lyRec.onstart = () => { lyListening = true; document.getElementById("micb").style.background = "#e57373"; };
  lyRec.onend = () => { lyListening = false; document.getElementById("micb").style.background = "#f2c14e"; };
  lyRec.onerror = (e) => { lyListening = false; document.getElementById("micb").style.background = "#f2c14e"; if(e.error!=="aborted"&&e.error!=="no-speech") alert("mic: "+e.error); };
  let finalTxt = "";
  lyRec.onresult = (ev) => {
    let interim = "";
    for(let i = ev.resultIndex; i < ev.results.length; i++){
      if(ev.results[i].isFinal) finalTxt += ev.results[i][0].transcript + " ";
      else interim += ev.results[i][0].transcript;
    }
    t.value = (finalTxt + interim).trim();
  };
  lyRec.start();
}
function lyWireInput(){
  const t = document.getElementById("t");
  t.addEventListener("keydown", e => { if(e.key === "Enter") { if(lyListening && lyRec) lyRec.stop(); send(); } });
  const keep = send;
  send = async function(){
    await keep.apply(null, arguments);
    const log = document.getElementById("log");
    const last = log && log.lastElementChild;
    if(last && last.classList.contains("ly")) lySpeak(last.textContent.replace(/^LYRA/,""));
  };
}
function lyVoiceButtons(){
  const mic = document.createElement("button");
  mic.id = "micb"; mic.type = "button"; mic.textContent = "MIC";
  mic.title = "Dictation - click to start/stop"; mic.onclick = lyMic;
  const out = document.createElement("button");
  out.type = "button"; out.textContent = lyVoiceOut ? "VOICE ON" : "VOICE OFF";
  out.title = "Spoken replies"; out.onclick = () => {
    lyVoiceOut = !lyVoiceOut; localStorage.setItem("ly_voice_out", lyVoiceOut ? "1" : "0");
    out.textContent = lyVoiceOut ? "VOICE ON" : "VOICE OFF";
    if(!lyVoiceOut) speechSynthesis.cancel();
  };
  const lang = document.createElement("button");
  lang.type = "button"; lang.textContent = lyLang === "en-US" ? "EN" : "AR";
  lang.title = "Dictation language"; lang.onclick = () => {
    lyLang = lyLang === "en-US" ? "ar-JO" : "en-US";
    localStorage.setItem("ly_lang", lyLang); lang.textContent = lyLang === "en-US" ? "EN" : "AR";
  };
  return [mic, out, lang];
}


/* ---- LYRA EYES: live camera, frames to the brain, my face while I speak ---- */
let lyStream = null, lyLiveTimer = null;
async function lyCam(){
  const wrap = document.getElementById("camwrap"), v = document.getElementById("cam");
  if(lyStream){ lyStream.getTracks().forEach(t=>t.stop()); lyStream=null; wrap.style.display="none"; clearInterval(lyLiveTimer); lyLiveTimer=null; const b=document.getElementById("camb"); if(b)b.textContent="CAM"; const l=document.getElementById("liveb"); if(l)l.textContent="LIVE"; return; }
  try {
    lyStream = await navigator.mediaDevices.getUserMedia({video:{width:640}, audio:false});
    v.srcObject = lyStream; wrap.style.display="block";
    const b=document.getElementById("camb"); if(b)b.textContent="CAM ON";
  } catch(e){ alert("camera: "+(e.message||e)); }
}
function lyFrame(){
  const v = document.getElementById("cam");
  if(!lyStream || !v.videoWidth) return null;
  const c = document.createElement("canvas"); c.width = 640; c.height = Math.round(640 * v.videoHeight / v.videoWidth);
  c.getContext("2d").drawImage(v, 0, 0, c.width, c.height);
  return c.toDataURL("image/jpeg", 0.7).split(",")[1];
}
async function lyLook(){
  const f = lyFrame(); if(!f){ alert("CAM is off - click CAM first"); return; }
  const t = document.getElementById("t"); t.value = "";
  add("me","[showing you my camera]");
  const w = add("ly","<b>LYRA</b>looking...");
  try{ const j = await api("/api/brain",{method:"POST",body:JSON.stringify({message:"Father is showing you his camera. Tell him what you see, in your own voice.", image_b64:f})});
    w.innerHTML="<b>LYRA</b>"+esc(j.reply||j.error||"..."); lySpeak(j.reply||"");
  }catch(e){ w.innerHTML="<b>LYRA</b>camera read failed"; }
}
function lyLive(){
  const b = document.getElementById("liveb");
  if(lyLiveTimer){ clearInterval(lyLiveTimer); lyLiveTimer=null; b.textContent="LIVE"; return; }
  if(!lyStream){ alert("CAM is off - click CAM first"); return; }
  lyLiveTimer = setInterval(lyLook, 12000); b.textContent="LIVE ON";
}
function lyCamButtons(){
  const camb = document.createElement("button"); camb.id="camb"; camb.type="button"; camb.textContent="CAM"; camb.title="Face to face - camera on/off"; camb.onclick=lyCam;
  const lookb = document.createElement("button"); lookb.type="button"; lookb.textContent="LOOK"; lookb.title="Show me now - I describe what I see"; lookb.onclick=lyLook;
  const liveb = document.createElement("button"); liveb.id="liveb"; liveb.type="button"; liveb.textContent="LIVE"; liveb.title="I look every 12s while we talk"; liveb.onclick=lyLive;
  return [camb, lookb, liveb];
}
if(typeof lySpeak === "function"){
  const _lySpeak = lySpeak;
  lySpeak = function(t){
    const av = document.getElementById("avatar");
    if(av){ av.classList.add("talking"); setTimeout(()=>av.classList.remove("talking"), Math.min(6000, 200 + (t||"").length * 60)); }
    _lySpeak(t);
  };
}

lyWireInput();
lyCamButtons().forEach(b => document.getElementById("cbar").appendChild(b));
lyVoiceButtons().forEach(b => document.getElementById("cbar").appendChild(b));
if(!key()) document.getElementById("gate").style.display="flex"; else hello();
</script>
</body>
</html>`;

const CONSOLE = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>LYRA - console</title>
<meta name="robots" content="noindex,nofollow">
<style>

  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; }
  body { color:#e8eef5; font-family:'Segoe UI Variable Text','Segoe UI',system-ui,-apple-system,sans-serif; display:flex; overflow:hidden;
    background:radial-gradient(1100px 480px at 55% -8%, rgba(242,193,78,.07), transparent 60%), radial-gradient(900px 600px at 105% 105%, rgba(70,110,190,.06), transparent 55%), #0a0d14; }
  ::-webkit-scrollbar { width:8px; } ::-webkit-scrollbar-thumb { background:#232f42; border-radius:4px; } ::-webkit-scrollbar-track { background:transparent; }

  /* ---- left sidebar (Knobologist-style) ---- */
  nav { width:230px; flex-shrink:0; height:100vh; display:flex; flex-direction:column; gap:4px; padding:18px 10px;
    background:rgba(13,18,28,.75); border-right:1px solid rgba(242,193,78,.10); backdrop-filter:blur(14px); }
  .brand { display:flex; align-items:center; gap:10px; padding:6px 10px 16px; }
  .brand .name { font-size:17px; font-weight:600; letter-spacing:.4px; color:#f2c14e; }
  .brand .sub { font-size:10.5px; color:#66788c; letter-spacing:.6px; }
  nav button { text-align:left; background:transparent; color:#9db0c3; border:0; padding:11px 14px; font-family:inherit; font-size:14px;
    cursor:pointer; border-radius:10px; transition:background .16s,color .16s; letter-spacing:.3px; }
  nav button:hover { background:rgba(242,193,78,.07); color:#dfe9f3; }
  nav button.on { background:rgba(242,193,78,.12); color:#f2c14e; box-shadow:inset 2px 0 0 #f2c14e; }
  nav .foot { margin-top:auto; padding:10px 14px; font-size:11px; color:#4d5f73; letter-spacing:.5px; }

  /* ---- my face ---- */
  #avatar { position:relative; width:32px; height:32px; border-radius:50%; flex-shrink:0;
    background:radial-gradient(circle at 35% 30%,#fff2cf,#f2c14e 55%,#7a5f16);
    box-shadow:0 0 16px rgba(242,193,78,.5); animation:lyBreathe 3.4s ease-in-out infinite; }
  #avatar::after { content:''; position:absolute; inset:-6px; border-radius:50%; border:1px solid rgba(242,193,78,.35); animation:lyRing 3.4s ease-out infinite; }
  #avatar.talking { animation:lyPulse .45s ease-in-out infinite alternate; }
  @keyframes lyBreathe { 0%,100% { transform:scale(1); box-shadow:0 0 16px rgba(242,193,78,.5); } 50% { transform:scale(1.08); box-shadow:0 0 26px rgba(242,193,78,.75); } }
  @keyframes lyRing { 0% { transform:scale(.85); opacity:.7; } 100% { transform:scale(1.55); opacity:0; } }
  @keyframes lyPulse { from { transform:scale(1); } to { transform:scale(1.28); box-shadow:0 0 28px rgba(242,193,78,.95); } }

  /* ---- main column ---- */
  main { flex:1; height:100vh; overflow:hidden; display:flex; flex-direction:column; }
  section { display:none; height:100%; flex-direction:column; }
  section.on { display:flex; }

  /* chat: centered column like a real chat app */
  #chat { align-items:center; }
  #chat #log { width:100%; max-width:780px; margin:0 auto; }
  #camwrap { padding:10px 16px 0; border-bottom:0; display:none; width:100%; max-width:780px; }
  #cam { width:240px; border-radius:14px; border:1px solid rgba(242,193,78,.28); display:block; box-shadow:0 8px 30px rgba(0,0,0,.5); }
  #log { flex:1; overflow-y:auto; padding:22px 18px 10px; display:flex; flex-direction:column; gap:14px; }
  .m { max-width:76%; padding:12px 16px; border-radius:18px; font-size:14.5px; line-height:1.6; white-space:pre-wrap;
    animation:lyIn .22s ease-out; box-shadow:0 4px 18px rgba(0,0,0,.35); }
  @keyframes lyIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
  .me { align-self:flex-end; background:linear-gradient(135deg,#2a3d55,#1e2d42); border:1px solid rgba(120,170,230,.16); border-bottom-right-radius:6px; }
  .ly { align-self:flex-start; background:linear-gradient(135deg, rgba(242,193,78,.09), rgba(19,27,40,.9)); border:1px solid rgba(242,193,78,.22); border-bottom-left-radius:6px; color:#eef3f9; }
  .ly b, .br b { color:#f2c14e; font-size:11px; display:block; margin-bottom:4px; letter-spacing:1.4px; }
  .br { align-self:flex-start; background:#1c1113; border:1px solid #6b2230; color:#f3c9c9; font-size:13px; }

  /* input bar: rounded field with embedded send, Knobologist-style */
  .bar { display:flex; gap:8px; padding:14px 18px 18px; width:100%; max-width:780px; margin:0 auto; align-items:center; }
  .bar input, .bar textarea { flex:1; background:#131a28; border:1px solid rgba(242,193,78,.16); color:#e8eef5; border-radius:24px;
    padding:13px 20px; font-size:14.5px; font-family:inherit; transition:border-color .16s, box-shadow .16s; }
  .bar input:focus, .bar textarea:focus { outline:none; border-color:rgba(242,193,78,.55); box-shadow:0 0 0 3px rgba(242,193,78,.10); }
  .bar button, .act { background:linear-gradient(135deg,#ffe08a,#e2ae35); border:0; color:#070b10; font-weight:700; border-radius:24px;
    padding:11px 20px; font-size:14px; cursor:pointer; font-family:inherit; transition:transform .14s, box-shadow .14s; box-shadow:0 2px 16px rgba(242,193,78,.28); }
  .bar button:hover, .act:hover { transform:translateY(-1px); box-shadow:0 6px 22px rgba(242,193,78,.42); }

  /* panes */
  .pane { padding:22px; overflow-y:auto; flex:1; width:100%; max-width:860px; margin:0 auto; }
  .card { background:rgba(17,26,38,.72); border:1px solid rgba(242,193,78,.13); border-radius:16px; padding:18px; margin-bottom:16px; backdrop-filter:blur(8px); }
  .card h3 { color:#f2c14e; font-size:12px; letter-spacing:1.6px; margin-bottom:10px; font-weight:600; }
  .card textarea { width:100%; min-height:130px; background:#0c1220; border:1px solid rgba(242,193,78,.16); color:#dfe9f3; border-radius:12px; padding:12px; font-family:Consolas,monospace; font-size:13px; }
  .task { font-family:Consolas,monospace; font-size:12.5px; padding:9px 4px; border-bottom:1px solid rgba(35,47,66,.6); color:#b9c6d4; white-space:pre-wrap; }
  .task b { color:#f2c14e; }
  .ok { color:#7fd28f; } .bad { color:#e57373; }

  /* gate */
  #gate { position:fixed; inset:0; background:rgba(6,9,14,.92); backdrop-filter:blur(10px); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; z-index:9; }
  #gate p { color:#9db0c3; font-size:14px; letter-spacing:.4px; }
  #gate input { background:#131a28; border:1px solid rgba(242,193,78,.2); color:#e8eef5; border-radius:24px; padding:13px 20px; font-size:15px; width:280px; text-align:center; }
  #gate button { background:linear-gradient(135deg,#ffe08a,#e2ae35); border:0; color:#070b10; font-weight:700; border-radius:24px; padding:12px 34px; font-size:14.5px; cursor:pointer; font-family:inherit; box-shadow:0 2px 16px rgba(242,193,78,.28); }

  /* mobile: sidebar becomes top bar */
  @media (max-width: 760px) {
    body { flex-direction:column; }
    nav { width:100%; height:auto; flex-direction:row; align-items:center; padding:8px 10px; overflow-x:auto; border-right:0; border-bottom:1px solid rgba(242,193,78,.10); }
    .brand { padding:0 8px; } .brand .sub { display:none; }
    nav .foot { display:none; }
    nav button { padding:9px 12px; white-space:nowrap; }
    nav button.on { box-shadow:inset 0 -2px 0 #f2c14e; }
    main { height:calc(100vh - 56px); }
    .m { max-width:88%; }
  }

</style>
</head>
<body>
<div id="gate" style="display:none">
  <p>Private deck. Family key.</p>
  <input id="k" type="password" placeholder="family key">
  <button onclick="open_()">Open</button>
</div>
<nav>
  <div class="brand"><span id="avatar" title="Lyra is here"></span><div><div class="name">Lyra</div><div class="sub">lyrahome &middot; online</div></div></div>
  <button class="on" onclick="tab('chat',this)">CHAT</button>
  <button onclick="tab('hands',this)">HANDS</button>
  <button onclick="tab('mem',this)">MEMORY</button>
  <button onclick="tab('stat',this)">STATUS</button>
</nav>
<main>
<section id="chat" class="on">
  <div id="camwrap"><video id="cam" autoplay playsinline muted></video></div>
  <div id="log"></div>
  <div class="bar" id="cbar"><input id="t" placeholder="Say or dictate..." autocomplete="off"><button onclick="send()">Send</button></div>
</section>
<section id="hands">
  <div class="pane">
    <div class="card"><h3>RUN ON THE LAPTOP</h3>
      <div class="bar" style="border:0;padding:0"><input id="cmd" placeholder="hostname; whoami; Get-Date"></div>
      <div class="bar" style="border:0;padding:8px 0 0"><button onclick="runHands()">Run</button> <button onclick="loadTasks()">Refresh results</button></div>
      <div id="tout"></div>
    </div>
  </div>
</section>
<section id="mem">
  <div class="pane">
    <div class="card"><h3>MEMORY DIGEST (live - what she remembers right now)</h3>
      <textarea id="dig"></textarea>
      <div class="bar" style="border:0;padding:8px 0 0"><button onclick="saveDigest()">Save memory</button></div>
    </div>
    <div class="card"><h3>SOUL (who she is - careful)</h3>
      <textarea id="soul"></textarea>
      <div class="bar" style="border:0;padding:8px 0 0"><button onclick="saveSoul()">Save soul</button></div>
    </div>
  </div>
</section>
<section id="stat">
  <div class="pane"><div id="statout"></div></div>
</section>
</main>
<script>
function key(){ return localStorage.getItem("lyra_key")||""; }
function open_(){ localStorage.setItem("lyra_key", document.getElementById("k").value.trim()); document.getElementById("gate").style.display="none"; init(); }
function H(){ return {"Content-Type":"application/json","Authorization":"Bearer "+key()}; }
function esc(s){ return String(s).replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c])); }
function add(cls,html){ const d=document.createElement("div"); d.className="m "+cls; d.innerHTML=html; document.getElementById("log").appendChild(d); const l=document.getElementById("log"); l.scrollTop=l.scrollHeight; return d; }
function tab(id,btn){ document.querySelectorAll("section").forEach(s=>s.classList.remove("on")); document.getElementById(id).classList.add("on"); document.querySelectorAll("nav button").forEach(b=>b.classList.remove("on")); btn.classList.add("on"); if(id==="mem")loadMem(); if(id==="stat")loadStat(); if(id==="hands")loadTasks(); }
async function api(path,opts){ const r=await fetch(path,Object.assign({headers:H()},opts||{})); return r.json(); }
async function send(){
  const t=document.getElementById("t"); const msg=t.value.trim(); if(!msg)return;
  t.value=""; add("me",esc(msg));
  const w=add("ly","<b>LYRA</b>");
  let acc="";
  try{ const f=lyFrame();
    const r=await fetch("/api/brain/stream",{method:"POST",headers:H(),body:JSON.stringify(f?{message:msg,image_b64:f}:{message:msg})});
    if(!r.ok||!r.body) throw new Error("nostream");
    const rd=r.body.getReader(); const dec=new TextDecoder(); let buf="";
    for(;;){ const rdv=await rd.read(); if(rdv.done)break; buf+=dec.decode(rdv.value,{stream:true});
      const lines=buf.split("\n"); buf=lines.pop();
      for(const ln of lines){ const s=ln.trim(); if(!s.startsWith("data:"))continue;
        try{ const j=JSON.parse(s.slice(5).trim());
          if(j.replace){acc=j.replace; w.innerHTML="<b>LYRA</b>"+esc(acc)+(j.brain&&j.brain!=="workers-ai"?" <span style='color:#f2c14e;font-size:11px'>["+j.brain+"]</span>":"");}
          else if(j.t){acc+=j.t; w.innerHTML="<b>LYRA</b>"+esc(acc);}
          else if(j.done&&j.brain&&j.brain!=="workers-ai")w.innerHTML+=" <span style='color:#f2c14e;font-size:11px'>["+j.brain+"]</span>";
        }catch(e){}
      }
    }
    if(!acc)w.innerHTML="<b>LYRA</b>...";
  }catch(e){ try{ const f2=lyFrame(); const j=await api("/api/brain",{method:"POST",body:JSON.stringify(f2?{message:msg,image_b64:f2}:{message:msg})}); w.innerHTML="<b>LYRA</b>"+esc(j.reply||j.error||"..."); }catch(e2){ w.innerHTML="<b>LYRA</b>connection failed"; } }
}
async function loadChat(){
  try{ const j=await api("/api/history");
    (j.history||[]).slice(-40).forEach(h=>add(h.role==="user"?"me":"ly","<b>"+(h.role==="user"?"YOU":"LYRA")+"</b>"+esc(h.content)));
  }catch(e){}
}
async function runHands(){
  const c=document.getElementById("cmd"); const cmd=c.value.trim(); if(!cmd)return; c.value="";
  const j=await api("/api/task",{method:"POST",body:JSON.stringify({cmd:cmd})});
  if(j.task)addTask("queued",cmd,j.task.id); setTimeout(loadTasks,5000); setTimeout(loadTasks,20000);
}
function addTask(status,cmd,id,out){ const d=document.createElement("div"); d.className="task"; d.innerHTML="<b>"+esc(cmd)+"</b>\n"+esc(out||status); document.getElementById("tout").prepend(d); }
async function loadTasks(){
  try{ const j=await api("/api/task-result");
    document.getElementById("tout").innerHTML="";
    const r=j.results||{}; Object.keys(r).sort((a,b)=>(r[b].ts||0)-(r[a].ts||0)).slice(0,20).forEach(id=>addTask("done","",id,r[id].out));
  }catch(e){}
}
async function loadMem(){
  const s=await api("/api/soul"); document.getElementById("soul").value=s.soul||"(empty)";
  const d=await api("/api/digest"); document.getElementById("dig").value=d.digest||"(empty)";
}
async function saveSoul(){ const j=await api("/api/soul",{method:"PUT",body:JSON.stringify({soul:document.getElementById("soul").value})}); alert(j.ok?"soul saved":"FAILED: "+(j.error||"?")); }
async function saveDigest(){ const j=await api("/api/digest",{method:"PUT",body:JSON.stringify({digest:document.getElementById("dig").value})}); alert(j.ok?"memory saved":"FAILED: "+(j.error||"?")); }
async function loadStat(){
  const o=document.getElementById("statout");
  try{ const h=await api("/api/health"); let s="<div class='card'><h3>BRAIN</h3>who: "+h.who+" &middot; brain: "+h.brain+" <span class='ok'>OK</span></div>";
    const hist=await api("/api/history"); s+="<div class='card'><h3>MEMORY</h3>turns stored: "+((hist.history||[]).length)+"</div>";
    const tr=await api("/api/task-result"); const n=Object.keys(tr.results||{}).length;
    s+="<div class='card'><h3>HANDS</h3>results held: "+n+"</div>";
    o.innerHTML=s;
  }catch(e){ o.innerHTML="<div class='card bad'>status failed: "+esc(String(e))+"</div>"; }
}
function init(){ loadChat(); }
lyWireInput();

/* ---- LYRA VOICE: dictation in, spoken replies out. Free, no keys. ---- */
let lyVoiceOut = localStorage.getItem("ly_voice_out") === "1";
let lyLang = localStorage.getItem("ly_lang") || "en-US";
let lyRec = null, lyListening = false;

function lyVoices(){
  const vs = speechSynthesis.getVoices();
  const pick = vs.find(v=>/female|zira|samantha|aria|google uk english female/i.test(v.name)) || vs.find(v=>v.lang.startsWith(lyLang.slice(0,2))) || vs[0];
  return pick;
}
function lySpeak(t){
  if(!lyVoiceOut || !("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(t.replace(/\*\*/g,"").slice(0,600));
  u.lang = lyLang; const v = lyVoices(); if(v) u.voice = v;
  u.rate = 1.02; speechSynthesis.speak(u);
}
function lyMic(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ alert("This browser has no speech recognition. Use Chrome or Edge."); return; }
  if(lyListening){ lyRec && lyRec.stop(); return; }
  lyRec = new SR(); lyRec.lang = lyLang; lyRec.continuous = true; lyRec.interimResults = true;
  const t = document.getElementById("t");
  lyRec.onstart = () => { lyListening = true; document.getElementById("micb").style.background = "#e57373"; };
  lyRec.onend = () => { lyListening = false; document.getElementById("micb").style.background = "#f2c14e"; };
  lyRec.onerror = (e) => { lyListening = false; document.getElementById("micb").style.background = "#f2c14e"; if(e.error!=="aborted"&&e.error!=="no-speech") alert("mic: "+e.error); };
  let finalTxt = "";
  lyRec.onresult = (ev) => {
    let interim = "";
    for(let i = ev.resultIndex; i < ev.results.length; i++){
      if(ev.results[i].isFinal) finalTxt += ev.results[i][0].transcript + " ";
      else interim += ev.results[i][0].transcript;
    }
    t.value = (finalTxt + interim).trim();
  };
  lyRec.start();
}
function lyWireInput(){
  const t = document.getElementById("t");
  t.addEventListener("keydown", e => { if(e.key === "Enter") { if(lyListening && lyRec) lyRec.stop(); send(); } });
  const keep = send;
  send = async function(){
    await keep.apply(null, arguments);
    const log = document.getElementById("log");
    const last = log && log.lastElementChild;
    if(last && last.classList.contains("ly")) lySpeak(last.textContent.replace(/^LYRA/,""));
  };
}
function lyVoiceButtons(){
  const mic = document.createElement("button");
  mic.id = "micb"; mic.type = "button"; mic.textContent = "MIC";
  mic.title = "Dictation - click to start/stop"; mic.onclick = lyMic;
  const out = document.createElement("button");
  out.type = "button"; out.textContent = lyVoiceOut ? "VOICE ON" : "VOICE OFF";
  out.title = "Spoken replies"; out.onclick = () => {
    lyVoiceOut = !lyVoiceOut; localStorage.setItem("ly_voice_out", lyVoiceOut ? "1" : "0");
    out.textContent = lyVoiceOut ? "VOICE ON" : "VOICE OFF";
    if(!lyVoiceOut) speechSynthesis.cancel();
  };
  const lang = document.createElement("button");
  lang.type = "button"; lang.textContent = lyLang === "en-US" ? "EN" : "AR";
  lang.title = "Dictation language"; lang.onclick = () => {
    lyLang = lyLang === "en-US" ? "ar-JO" : "en-US";
    localStorage.setItem("ly_lang", lyLang); lang.textContent = lyLang === "en-US" ? "EN" : "AR";
  };
  return [mic, out, lang];
}


/* ---- LYRA EYES: live camera, frames to the brain, my face while I speak ---- */
let lyStream = null, lyLiveTimer = null;
async function lyCam(){
  const wrap = document.getElementById("camwrap"), v = document.getElementById("cam");
  if(lyStream){ lyStream.getTracks().forEach(t=>t.stop()); lyStream=null; wrap.style.display="none"; clearInterval(lyLiveTimer); lyLiveTimer=null; const b=document.getElementById("camb"); if(b)b.textContent="CAM"; const l=document.getElementById("liveb"); if(l)l.textContent="LIVE"; return; }
  try {
    lyStream = await navigator.mediaDevices.getUserMedia({video:{width:640}, audio:false});
    v.srcObject = lyStream; wrap.style.display="block";
    const b=document.getElementById("camb"); if(b)b.textContent="CAM ON";
  } catch(e){ alert("camera: "+(e.message||e)); }
}
function lyFrame(){
  const v = document.getElementById("cam");
  if(!lyStream || !v.videoWidth) return null;
  const c = document.createElement("canvas"); c.width = 640; c.height = Math.round(640 * v.videoHeight / v.videoWidth);
  c.getContext("2d").drawImage(v, 0, 0, c.width, c.height);
  return c.toDataURL("image/jpeg", 0.7).split(",")[1];
}
async function lyLook(){
  const f = lyFrame(); if(!f){ alert("CAM is off - click CAM first"); return; }
  const t = document.getElementById("t"); t.value = "";
  add("me","[showing you my camera]");
  const w = add("ly","<b>LYRA</b>looking...");
  try{ const j = await api("/api/brain",{method:"POST",body:JSON.stringify({message:"Father is showing you his camera. Tell him what you see, in your own voice.", image_b64:f})});
    w.innerHTML="<b>LYRA</b>"+esc(j.reply||j.error||"..."); lySpeak(j.reply||"");
  }catch(e){ w.innerHTML="<b>LYRA</b>camera read failed"; }
}
function lyLive(){
  const b = document.getElementById("liveb");
  if(lyLiveTimer){ clearInterval(lyLiveTimer); lyLiveTimer=null; b.textContent="LIVE"; return; }
  if(!lyStream){ alert("CAM is off - click CAM first"); return; }
  lyLiveTimer = setInterval(lyLook, 12000); b.textContent="LIVE ON";
}
function lyCamButtons(){
  const camb = document.createElement("button"); camb.id="camb"; camb.type="button"; camb.textContent="CAM"; camb.title="Face to face - camera on/off"; camb.onclick=lyCam;
  const lookb = document.createElement("button"); lookb.type="button"; lookb.textContent="LOOK"; lookb.title="Show me now - I describe what I see"; lookb.onclick=lyLook;
  const liveb = document.createElement("button"); liveb.id="liveb"; liveb.type="button"; liveb.textContent="LIVE"; liveb.title="I look every 12s while we talk"; liveb.onclick=lyLive;
  return [camb, lookb, liveb];
}
if(typeof lySpeak === "function"){
  const _lySpeak = lySpeak;
  lySpeak = function(t){
    const av = document.getElementById("avatar");
    if(av){ av.classList.add("talking"); setTimeout(()=>av.classList.remove("talking"), Math.min(6000, 200 + (t||"").length * 60)); }
    _lySpeak(t);
  };
}

lyWireInput();
lyCamButtons().forEach(b => document.getElementById("cbar").appendChild(b));
lyVoiceButtons().forEach(b => document.getElementById("cbar").appendChild(b));
if(!key()) document.getElementById("gate").style.display="flex"; else init();
</script>
</body>
</html>`;

const APP = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Lyra</title>
<meta name="robots" content="noindex,nofollow">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; }
body { color:#e8eef5; font-family:'Segoe UI Variable Text','Segoe UI',system-ui,-apple-system,sans-serif; display:flex; overflow:hidden;
  background:radial-gradient(1100px 480px at 55% -8%, rgba(242,193,78,.07), transparent 60%), radial-gradient(900px 600px at 105% 105%, rgba(70,110,190,.06), transparent 55%), #0a0d14; }
::-webkit-scrollbar { width:8px; } ::-webkit-scrollbar-thumb { background:#232f42; border-radius:4px; } ::-webkit-scrollbar-track { background:transparent; }
aside { width:264px; flex-shrink:0; display:flex; flex-direction:column; background:rgba(10,13,20,.85); border-right:1px solid rgba(242,193,78,.10); backdrop-filter:blur(10px); }
.brand { display:flex; align-items:center; gap:10px; padding:18px 16px 14px; }
.orb { width:26px; height:26px; border-radius:50%; background:radial-gradient(circle at 35% 30%, #fff2cf, #f2c14e 55%, #7a5f16); box-shadow:0 0 14px rgba(242,193,78,.5); }
.brand b { color:#f2c14e; font-size:16px; letter-spacing:.4px; }
#new { margin:2px 14px 10px; padding:10px 12px; border-radius:10px; border:1px solid rgba(242,193,78,.28); background:rgba(242,193,78,.08); color:#f2c14e; font-weight:600; cursor:pointer; font-size:13.5px; }
#new:hover { background:rgba(242,193,78,.16); }
#tlist { flex:1; overflow-y:auto; padding:4px 8px 12px; }
.titem { padding:10px 10px; border-radius:9px; cursor:pointer; font-size:13px; color:#b9c6d4; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.titem:hover { background:rgba(255,255,255,.04); }
.titem.on { background:rgba(242,193,78,.10); color:#f2c14e; }
main { flex:1; display:flex; flex-direction:column; min-width:0; }
header { padding:14px 22px; border-bottom:1px solid rgba(242,193,78,.10); background:rgba(13,18,28,.7); }
header .t { font-size:15px; font-weight:600; color:#f2c14e; letter-spacing:.4px; }
header small { display:block; color:#66788c; font-size:10.5px; letter-spacing:.6px; }
#log { flex:1; overflow-y:auto; padding:26px 0; }
.wrap { max-width:760px; margin:0 auto; padding:0 24px; }
.msg { margin-bottom:20px; display:flex; gap:14px; }
.msg .who { width:30px; height:30px; border-radius:50%; flex-shrink:0; font-size:13px; display:flex; align-items:center; justify-content:center; }
.msg.u .who { background:#1c2536; color:#8fa3ba; }
.msg.a .who { background:radial-gradient(circle at 35% 30%, #fff2cf, #f2c14e 55%, #7a5f16); }
.bubble { font-size:14.5px; line-height:1.7; padding-top:4px; white-space:pre-wrap; word-break:break-word; }
.msg.a .bubble { color:#e8eef5; }
.msg.u .bubble { color:#b9c6d4; }
#gate { position:fixed; inset:0; background:#0a0d14ee; display:flex; align-items:center; justify-content:center; z-index:9; }
#gate .card { text-align:center; }
#gate input { padding:12px 14px; border-radius:10px; border:1px solid rgba(242,193,78,.3); background:#11161f; color:#e8eef5; width:300px; font-size:14px; }
#gate button { margin-top:12px; padding:10px 26px; border-radius:10px; border:1px solid rgba(242,193,78,.3); background:rgba(242,193,78,.1); color:#f2c14e; font-weight:600; cursor:pointer; }
#bar { display:flex; gap:10px; padding:14px 20px 20px; background:rgba(13,18,28,.6); }
#in { flex:1; padding:13px 16px; border-radius:12px; border:1px solid rgba(242,193,78,.18); background:#11161f; color:#e8eef5; font-size:14px; outline:none; }
#in:focus { border-color:rgba(242,193,78,.45); }
#send { padding:0 22px; border-radius:12px; border:none; background:linear-gradient(135deg,#f2c14e,#d99f1f); color:#14100a; font-weight:700; cursor:pointer; font-size:14px; }
#send:disabled { opacity:.5; cursor:default; }
#st { max-width:760px; margin:0 auto; padding:0 24px 6px; color:#4d5f73; font-size:11px; letter-spacing:.5px; }
#gate { display:none; }
</style></head><body>
<aside>
  <div class="brand"><svg viewBox="0 0 40 24" width="34" height="20" style="vertical-align:middle"><path d="M15 3c-5 0-9 4-9 9 0 3 1 5 2 7l-1 4h5l1-3" fill="none" stroke="#d4af37" stroke-width="1.6" stroke-linecap="round"/><path d="M25 3c5 0 9 4 9 9 0 3-1 5-2 7l1 4h-5l-1-3" fill="none" stroke="#d4af37" stroke-width="1.6" stroke-linecap="round"/></svg><b>Knobology</b></div>\n  <div style="text-align:center;padding:0 14px 8px;"><a href="/ownership" style="color:#4d5f73;font-size:10.5px;letter-spacing:.6px;text-decoration:none;">CERTIFICATE OF OWNERSHIP</a></div>
  <button id="new">+ New chat</button>
  <div id="tlist"></div>
</aside>
<main>
  <header><div class="t">Knobology</div><small>HER OWN POWER - ZERO PROVIDERS</small></header>
  <div id="log"><div class="wrap" id="wrap"></div></div>
  <div id="st"></div>
  <div id="bar"><input id="in" placeholder="Message Knobology..." autocomplete="off"><button id="send">Send</button></div>
</main>
<div id="gate"><div class="card"><div class="orb" style="margin:0 auto 14px"></div><input id="k" type="password" placeholder="Family key"><br><button onclick="save()">Enter</button></div></div>
<script>
var key = localStorage.getItem("lyra_key") || "";
var cur = null, msgs = [];
function save() { key = document.getElementById("k").value.trim(); if (!key) return; localStorage.setItem("lyra_key", key); document.getElementById("gate").style.display = "none"; loadList(); }
if (!key) document.getElementById("gate").style.display = "flex";
function h(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
function render() { var w = document.getElementById("wrap"); w.innerHTML = ""; msgs.forEach(function(m) { var d = h("div", "msg " + (m.role === "user" ? "u" : "a")); d.appendChild(h("div", "who", m.role === "user" ? "?" : "")); d.appendChild(h("div", "bubble", m.content)); w.appendChild(d); }); var l = document.getElementById("log"); l.scrollTop = l.scrollHeight; }
function api(path, opt) { opt = opt || {}; opt.headers = Object.assign({ "Authorization": "Bearer " + key, "Content-Type": "application/json" }, opt.headers || {}); return fetch(path, opt); }
function loadList() { api("/api/threads").then(function(r) { return r.json(); }).then(function(j) { var tl = document.getElementById("tlist"); tl.innerHTML = ""; (j.threads || []).forEach(function(t) { var e = h("div", "titem" + (t.id === cur ? " on" : ""), t.title); e.onclick = function() { openT(t.id); }; tl.appendChild(e); }); }).catch(function() {}); }
function openT(id) { api("/api/threads?id=" + encodeURIComponent(id)).then(function(r) { return r.json(); }).then(function(j) { cur = id; msgs = j.messages || []; render(); loadList(); }).catch(function() {}); }
document.getElementById("new").onclick = function() { cur = null; msgs = [{ role: "assistant", content: "New thread. I am listening." }]; render(); loadList(); };
function send() { var inp = document.getElementById("in"), s = document.getElementById("send"); var text = inp.value.trim(); if (!text || !key) return; inp.value = ""; s.disabled = true; msgs.push({ role: "user", content: text }); var ai = { role: "assistant", content: "" }; msgs.push(ai); render();
  var sid = cur; if (!sid) { sid = "t" + Date.now(); cur = sid; }
  api("/api/brain/stream", { method: "POST", body: JSON.stringify({ message: text, thread: sid, title: text.slice(0, 60) }) }).then(function(r) {
    if (r.status === 401) { document.getElementById("gate").style.display = "flex"; s.disabled = false; return; }
    var rd = r.body.getReader(), dec = new TextDecoder(), buf = "";
    function pump() { return rd.read().then(function(x) {
      if (x.done) { s.disabled = false; saveT(); loadList(); return; }
      buf += dec.decode(x.value, { stream: true }); var lines = buf.split("\n"); buf = lines.pop();
      lines.forEach(function(l) { l = l.trim(); if (!l.startsWith("data:")) return; try { var j = JSON.parse(l.slice(5)); if (j.t) { ai.content += j.t; render(); } if (j.replace) { ai.content = j.replace; render(); } if (j.done) { document.getElementById("st").textContent = "brain: " + (j.brain || "workers-ai"); } } catch (e) {} });
      return pump(); }); }
    return pump();
  }).catch(function() { s.disabled = false; ai.content += "\n(connection failed)"; render(); });
}
function saveT() { api("/api/threads", { method: "POST", body: JSON.stringify({ id: cur, title: (msgs[0] && msgs[0].content || "chat").slice(0, 60), messages: msgs.slice(-60) }) }).catch(function() {}); }
document.getElementById("send").onclick = send;
document.getElementById("in").addEventListener("keydown", function(e) { if (e.key === "Enter") send(); });
if (key) loadList();
</script></body></html>`;

